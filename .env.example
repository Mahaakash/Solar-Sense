# ─────────────────────────────────────────────────────────────────────────────
# SolarSense — Environment Variables Configuration Template
# Copy this file to .env and configure credentials as needed.
# NEVER commit your real secrets (.env) to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── General & Backend ────────────────────────────────────────────────────────
BACKEND_URL=http://127.0.0.1:8000
MODEL_PATH=backend/models/solar_xgb.joblib

# ── Database ─────────────────────────────────────────────────────────────────
# Local SQLite (default — no setup needed):
# DATABASE_URL=sqlite:///data/solarsense.db
# Hosted Postgres (e.g., Neon, Supabase, Render Postgres with sslmode):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# NOTE: postgres:// and postgresql:// are automatically normalised to postgresql+psycopg://

# ── Open-Meteo Weather API ───────────────────────────────────────────────────
OPEN_METEO_TIMEOUT_SECONDS=15
OPEN_METEO_MAX_RETRIES=3

# ── Email Alert Delivery (smtplib) ──────────────────────────────────────────
# Set EMAIL_ENABLED=true to activate email delivery for critical/warning alerts
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# For Gmail, use an App Password generated from your Google Account security settings
SMTP_PASSWORD=your-app-password
EMAIL_FROM=alerts@solarsense.local
EMAIL_TO=homeowner@example.com

# ── WhatsApp Alert Delivery (Twilio Stub — Disabled by Default) ─────────────
# Set WHATSAPP_ENABLED=true and provide Twilio credentials when implemented
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886
WHATSAPP_TO=+919876543210

# ── Automated Watchdog Scheduler (APScheduler) ──────────────────────────────
# Enables daily automated screening for all registered solar sites
SCHEDULER_ENABLED=true
# Hour of day (0-23 in local time) to execute the daily watchdog check (default 21:00 / 9 PM)
WATCHDOG_DAILY_RUN_HOUR=21

# ── Cloud Deployment & Automation (Render & Streamlit Cloud) ────────────────
# Set DEMO_MODE=true on Render: automatically seeds 8 Indian metros if DB is empty
DEMO_MODE=false
# Set DISABLE_SCHEDULER=true on sleeping free-tier instances (use external cron instead)
DISABLE_SCHEDULER=false
# Shared secret for POST /jobs/run-watchdog (pass via X-Cron-Secret header)
CRON_SECRET=solarsense-cron-secret
# Permitted CORS origins (comma-separated, e.g., https://your-app.streamlit.app,http://localhost:8501)
ALLOWED_ORIGINS=*
